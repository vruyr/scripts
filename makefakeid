__doc__ = """
Generate a fake identity (name + email) for captive portal logins.
Picks a random Faker locale and a random domain that resolves in DNS.
"""

import argparse
import asyncio
import random
import sys
import unicodedata
import anyascii
import babel.core
import dns.asyncresolver
import dns.exception
import faker
import faker.config


def main(*, locale, offline):
	fake, locale = _make_faker(locale)
	first = fake.first_name()
	last = fake.last_name()
	domain = fake.domain_name() if offline else _resolvable_domain(fake)
	local_part = anyascii.anyascii(f"{first}.{last}").lower()
	local_part = "".join(c for c in local_part if c.isalnum() or c == ".")
	email = f"{local_part}@{domain}"
	postcode = fake.postcode()
	print(_locale_display_name(locale))
	print(first)
	print(last)
	print(email)
	print(postcode)


def parse_args(*, args, prog):
	parser = argparse.ArgumentParser(
		prog=prog,
		description=__doc__,
		add_help=False,
	)
	parser.add_argument(
		"--help", "-h",
		action="help",
		help="show this help message and exit",
	)
	parser.add_argument(
		"--locale", "-l", metavar="LOCALE",
		action="store", dest="locale", default=None, required=False,
		help="Faker locale to use (e.g. de_DE, fr_FR); default: random",
	)
	parser.add_argument(
		"--offline",
		action="store_true", dest="offline", default=False, required=False,
		help="skip DNS lookups and use the domain without validation",
	)
	opts = parser.parse_args(args)
	return vars(opts)


def _make_faker(locale=None):
	if locale is not None:
		try:
			return faker.Faker(locale), locale
		except AttributeError:
			sys.exit(f"error: unknown locale {locale!r}; see faker.config.AVAILABLE_LOCALES")
	locs = list(faker.config.AVAILABLE_LOCALES)
	while True:
		loc = random.choice(locs)
		if loc in _DEPRECATED_LOCALES or loc in _EXCLUDED_LOCALES:
			continue
		f = faker.Faker(loc)
		if _is_latin(f):
			return f, loc


def _resolvable_domain(fake, attempts=50):
	candidates = list(dict.fromkeys(fake.domain_name() for _ in range(attempts)))
	domain = asyncio.run(_first_resolvable(candidates))
	return domain if domain is not None else fake.free_email_domain()


async def _first_resolvable(domains, timeout=1.0, concurrency=8):
	sem = asyncio.Semaphore(concurrency)
	async def probe(domain):
		async with sem:
			return await _probe_domain(domain, timeout)
	tasks = [asyncio.create_task(probe(d)) for d in domains]
	try:
		for fut in asyncio.as_completed(tasks):
			if (domain := await fut) is not None:
				return domain
	finally:
		for task in tasks:
			task.cancel()
		await asyncio.gather(*tasks, return_exceptions=True)
	return None


async def _probe_domain(domain, timeout):
	resolver = dns.asyncresolver.Resolver()
	resolver.timeout = timeout
	resolver.lifetime = timeout
	async def query(rtype):
		try:
			await resolver.resolve(domain, rtype)
			return True
		except (dns.exception.DNSException, UnicodeError):
			return False
	results = await asyncio.gather(*(query(rt) for rt in ("A", "AAAA", "MX")))
	return domain if any(results) else None


def _is_latin(f):
	sample = f.first_name() + f.last_name()
	return all(
		unicodedata.name(c, "").startswith("LATIN") or not c.isalpha()
		for c in sample
	)


def _locale_display_name(loc):
	try:
		name = babel.core.Locale.parse(loc, sep="_").get_display_name("en")
		return f"{name} ({loc})"
	except babel.core.UnknownLocaleError:
		return loc


_DEPRECATED_LOCALES = {
	"fr_QC",   # use fr_CA
}

_EXCLUDED_LOCALES = {
	"az_AZ",
	"tr_TR",
}


def smain(argv=None):
	if argv is None:
		argv = sys.argv
	opts = parse_args(args=argv[1:], prog=argv[0])
	return main(**opts)


if __name__ == "__main__":
	sys.exit(smain())
