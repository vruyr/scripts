#!/usr/bin/env zsh

setopt ERR_EXIT
typeset -g _zsh_last_command _zsh_last_line
TRAPDEBUG() {
	_zsh_last_command="$ZSH_DEBUG_CMD"
	_zsh_last_line="${funcfiletrace[1]##*:}"
}
TRAPZERR() {
	print -u2 "FAILING COMMAND (line $_zsh_last_line): $_zsh_last_command"
	echo
	return 1
}

if ! [[ $# -eq 1 && ( -d "$1" || -f "$1" ) ]]; then
	echo "USAGE: $0:t REPO_PATH_OR_BUNDLE"
	exit 1
fi

typeset -g bundle_path=""
if [[ -f "$1" ]]; then
	# A file is assumed to be a git bundle; don't cd so `git bundle verify`
	# can check prerequisites against the caller's current repository.
	bundle_path="$1"
else
	cd "$1"
fi

() {
	typeset -g USE_COLORS=""

	if [[ -n "${FZF_PREVIEW_COLUMNS}" ]]; then
		# The tty belongs to fzf while a preview is running, so OSC 11 is not
		# available; term-background falls back to the OS appearance (tracking
		# live light/dark switches) or the TERM_BACKGROUND exported by the
		# caller (see git-choose). Re-detected on every render on purpose.
		USE_COLORS="$(term-background 2>/dev/null || true)"
		return
	fi

	[[ -t 0 ]] || return

	USE_COLORS="$(term-background 2>/dev/null)" || true
}

TERM_WIDTH=${FZF_PREVIEW_COLUMNS:-${COLUMNS:-20}}

box_hl=$'\u2500'
box_vl=$'\u2502'
box_ul=$'\u250C'
box_ur=$'\u2510'
box_ll=$'\u2514'
box_lr=$'\u2518'

function hr() {
	local width="${1:-$TERM_WIDTH}"
	printf -v line '%*s' "$width" ''

	[ -n "$USE_COLORS" ] && printf '\e[2m' || true
	printf '%s' "${line// /$box_hl}"
	[ -n "$USE_COLORS" ] && printf '\e[0m' || true
}

function section() {
	local text="$1"

	if [[ "$text" == "---" ]]; then
		printf '\n'
		hr "$((TERM_WIDTH))"
		printf '\n'
		printf '\n'
		return
	fi

	local line_width=$((TERM_WIDTH-2))  # 2 = left and right corners
	local text_width=$((TERM_WIDTH-4))  # 4 = two vertical bars and two padding spaces

	printf '\n'

	printf '%s' "$box_ul"
	hr "$line_width"
	printf '%s' "$box_ur"

	printf '\n'

	if [ -n "$text" ]; then
		printf '%s ' "$box_vl"
		printf '%-*.*s' "$text_width" "$text_width" "$text"
		printf ' %s' "$box_vl"
		printf '\n'
	fi

	printf '%s' "$box_ll"
	hr "$line_width"
	printf '%s' "$box_lr"
	printf '\n'
}

function the_bat() {
	bat \
		--terminal-width \
		"$TERM_WIDTH" \
		--paging=never \
		--style=numbers \
		--decorations always \
		--color=always \
		--theme "${USE_COLORS:-ansi}" \
		"$@"
}

section "References"
git ls-remote --symref "${bundle_path:-.}"

if [[ -n "$bundle_path" ]]; then
	section "Bundle"
	# Run twice to keep stdout (refs, prerequisites, hash algorithm) and
	# stderr (okay/error status) from interleaving under buffering. Blank
	# lines separate each statement group.
	bundle_info="$(git bundle verify "$bundle_path" 2>/dev/null)" || true
	if [[ -n "$bundle_info" ]]; then
		printf '%s\n\n' "$bundle_info" | awk 'NR > 1 && /^The bundle / { print "" } { print } /^The bundle .*refs?:$/ { print "" }'
	fi
	# The brace group avoids zsh MULTIOS teeing stdout into the pipe.
	{ git bundle verify "$bundle_path" 1>/dev/null } 2>&1 | sed 's/^\(.*\) is okay$/okay: \1/' || true
	exit 0
fi

section "Config"
config_path="$(git rev-parse --git-path config)"
if [[ -f "$config_path" ]]; then
	the_bat --language ini "$config_path"
fi

section "Tree at HEAD"
git ls-tree HEAD --format "%(objectmode) %(objecttype) %(objectsize:padded) %(path)"

section "Contributors"
the_bat --line-range=:10 <(
	git --no-pager shortlog \
		--summary \
		--email \
		--numbered \
		--group=author \
		--group=trailer:co-authored-by \
		--group=committer \
		--all
)

for readme in README.md README.rst README.txt README; do
	oid="$(git rev-parse --verify HEAD:"$readme" 2>/dev/null || true)"
	[[ $? -eq 0 && -n "$oid" ]] || continue

	printf '\n'
	section "$readme"
	the_bat --file-name "$readme" <(git cat-file -p "HEAD:$readme")

	break
done
