import argparse
import json
import ssl
import sys
import time
import xml.etree.ElementTree as ET
from pathlib import Path
from urllib.parse import urlencode, urlunparse
from urllib.request import Request, urlopen


SYNCTHING_APP_CONFIG_DIR = Path.home() / "Library/Application Support/Syncthing"
SYNCTHING_APP_CONFIG_PATH = SYNCTHING_APP_CONFIG_DIR / "config.xml"

# How often we re-poll device completion while waiting.
POLL_INTERVAL = 0.25
# Per-device progress lines are emitted at most this often (the final
# "fully received" transition is always printed immediately, regardless).
PROGRESS_THROTTLE = 2.0
# When no remote device sharing the folder is online, we remind the user
# this often (polling itself stays at POLL_INTERVAL).
NO_REMOTES_WARN_INTERVAL = 5.0


# --------------------------------------------------------------------------
# Syncthing REST client
# --------------------------------------------------------------------------

class SyncthingClient:
	def __init__(self, base_url, api_key, ssl_ctx):
		self._base_url = base_url
		self._api_key = api_key
		self._ssl_ctx = ssl_ctx

	def _request(self, method, path, query=None, http_timeout=30):
		url = self._base_url + path
		if query:
			url += "?" + urlencode(query)
		req = Request(url, method=method, headers={"X-API-Key": self._api_key})
		with urlopen(req, context=self._ssl_ctx, timeout=http_timeout) as resp:
			body = resp.read()
		return json.loads(body) if body else None

	# http_timeout is the socket timeout; any other kwargs become query params
	# (note: the /rest/events endpoint has its own query param named 'timeout').
	def get(self, path, http_timeout=30, **query):
		return self._request("GET", path, query, http_timeout=http_timeout)

	def post(self, path, **query):
		return self._request("POST", path, query)


# --------------------------------------------------------------------------
# --wait-remote expression DSL
#
# Grammar (operators are keywords, case-insensitive; no implicit operators):
#
#     expr     := or_expr
#     or_expr  := and_expr (OR  and_expr)*
#     and_expr := unary    (AND unary)*
#     unary    := atom | '(' expr ')'
#     atom     := 'count:' INT | 'name:' VALUE | 'id:' VALUE
#     VALUE    := bareword (no spaces/parens/quotes) | JSON string
#
# AND binds tighter than OR; parentheses override. A VALUE may be a bareword
# or a JSON string literal (so names with spaces/quotes work):
#     name:"My \"main\" laptop"
#
# NOT is intentionally NOT implemented: "device is NOT synced" is not a
# meaningful wait condition (there is no use case for blocking until a node
# falls out of sync). The parser reserves the keyword so a future
# implementation has an obvious home; see parse_unary().
# --------------------------------------------------------------------------

_ATOM_PREFIXES = ("count:", "name:", "id:")
_KEYWORDS = {"AND", "OR", "NOT"}


class Token:
	__slots__ = ("kind", "value")

	def __init__(self, kind, value):
		self.kind = kind		# "PAREN" | "OP" | "ATOM"
		self.value = value


def _scan_json_string(s, i):
	"""Parse a JSON string literal starting at s[i] == '"'. Returns (text, next_i)."""
	j = i + 1
	while j < len(s):
		if s[j] == "\\":
			j += 2
			continue
		if s[j] == '"':
			j += 1
			break
		j += 1
	else:
		raise ValueError(f"unterminated quoted string in expression: {s[i:]!r}")
	return json.loads(s[i:j]), j


def _scan_bareword(s, i):
	"""Read until whitespace, paren, or quote. Returns (text, next_i)."""
	start = i
	while i < len(s) and not s[i].isspace() and s[i] not in "()\"":
		i += 1
	return s[start:i], i


def tokenize(expr):
	tokens = []
	i, n = 0, len(expr)
	while i < n:
		c = expr[i]
		if c.isspace():
			i += 1
			continue
		if c in "()":
			tokens.append(Token("PAREN", c))
			i += 1
			continue
		word, i = _scan_bareword(expr, i)
		matched_prefix = next((p for p in _ATOM_PREFIXES if word.lower().startswith(p)), None)
		if matched_prefix:
			prefix = matched_prefix
			value = word[len(prefix):]
			# A quoted value may follow the prefix directly (the bareword scan
			# stopped at the opening quote), e.g. name:"a b".
			if value == "" and i < n and expr[i] == '"':
				value, i = _scan_json_string(expr, i)
			tokens.append(Token("ATOM", (prefix, value)))
			continue
		if word.upper() in _KEYWORDS:
			tokens.append(Token("OP", word.upper()))
			continue
		raise ValueError(
			f"unexpected token {word!r}; expected an operator (AND/OR) or a "
			f"prefixed atom (count:/name:/id:)"
		)
	return tokens


# AST nodes. Each evaluates against `world`, a dict {device_id: is_fully_received}
# over all remote devices sharing the folder.

class And:
	def __init__(self, left, right):
		self.left, self.right = left, right

	def evaluate(self, world):
		return self.left.evaluate(world) and self.right.evaluate(world)

	def describe(self):
		return f"({self.left.describe()} AND {self.right.describe()})"


class Or:
	def __init__(self, left, right):
		self.left, self.right = left, right

	def evaluate(self, world):
		return self.left.evaluate(world) or self.right.evaluate(world)

	def describe(self):
		return f"({self.left.describe()} OR {self.right.describe()})"


class CountAtom:
	def __init__(self, n):
		self.n = n

	def evaluate(self, world):
		return sum(1 for received in world.values() if received) >= self.n

	def describe(self):
		return f"at least {self.n} device{'s' if self.n != 1 else ''} fully received"


class DeviceAtom:
	def __init__(self, device_id, name):
		self.device_id = device_id
		self.name = name

	def evaluate(self, world):
		return world.get(self.device_id, False)

	def describe(self):
		return f'device "{self.name}" ({self.device_id[:7]}…) fully received'


class Parser:
	"""Recursive-descent parser producing an AST.

	`resolve_device` maps a (prefix, value) name:/id: atom to a (device_id, name)
	pair, raising ValueError on unknown/ambiguous references.
	"""

	def __init__(self, tokens, resolve_device):
		self._tokens = tokens
		self._pos = 0
		self._resolve_device = resolve_device

	def _peek(self):
		return self._tokens[self._pos] if self._pos < len(self._tokens) else None

	def _advance(self):
		tok = self._tokens[self._pos]
		self._pos += 1
		return tok

	def parse(self):
		node = self.parse_or()
		if self._peek() is not None:
			raise ValueError("trailing tokens after a complete expression")
		return node

	def parse_or(self):
		node = self.parse_and()
		while (tok := self._peek()) and tok.kind == "OP" and tok.value == "OR":
			self._advance()
			node = Or(node, self.parse_and())
		return node

	def parse_and(self):
		node = self.parse_unary()
		while (tok := self._peek()) and tok.kind == "OP" and tok.value == "AND":
			self._advance()
			node = And(node, self.parse_unary())
		return node

	def parse_unary(self):
		tok = self._peek()
		if tok is None:
			raise ValueError("unexpected end of expression; expected an atom")
		if tok.kind == "OP" and tok.value == "NOT":
			# Reserved but unimplemented on purpose -- see the module comment.
			raise ValueError("NOT is not supported: waiting for a device to be "
				"un-synced is not a meaningful condition")
		if tok.kind == "PAREN" and tok.value == "(":
			self._advance()
			node = self.parse_or()
			close = self._peek()
			if not (close and close.kind == "PAREN" and close.value == ")"):
				raise ValueError("missing closing parenthesis")
			self._advance()
			return node
		if tok.kind == "ATOM":
			self._advance()
			return self._make_atom(tok.value)
		raise ValueError(f"expected an atom or '(', got {tok.value!r}")

	def _make_atom(self, atom):
		prefix, value = atom
		if prefix == "count:":
			try:
				n = int(value)
			except ValueError:
				raise ValueError(f"count: expects an integer, got {value!r}")
			if n < 1:
				raise ValueError(f"count: must be >= 1, got {n}")
			return CountAtom(n)
		device_id, name = self._resolve_device(prefix, value)
		return DeviceAtom(device_id, name)


def make_device_resolver(remote_devices):
	"""remote_devices: dict {device_id: name}. Matching is case-insensitive;
	id: accepts a unique prefix. Raises ValueError on unknown/ambiguous refs."""

	def resolve(prefix, value):
		needle = value.casefold()
		if prefix == "name:":
			matches = [(did, nm) for did, nm in remote_devices.items() if nm.casefold() == needle]
			what = f'name "{value}"'
		else:  # id:
			matches = [(did, nm) for did, nm in remote_devices.items() if did.casefold().startswith(needle)]
			what = f'id "{value}"'
		if not matches:
			known = ", ".join(f'"{nm}" ({did[:7]}…)' for did, nm in remote_devices.items()) or "(none)"
			raise ValueError(f"no remote device matches {what}; known devices: {known}")
		if len(matches) > 1:
			ambiguous = ", ".join(f'"{nm}" ({did[:7]}…)' for did, nm in matches)
			raise ValueError(f"{what} is ambiguous; matches: {ambiguous}")
		return matches[0]

	return resolve


# --------------------------------------------------------------------------
# Wait loop
# --------------------------------------------------------------------------

def _humanize_bytes(n):
	step = 1024.0
	for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
		if abs(n) < step or unit == "TiB":
			return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
		n /= step


def is_remote_fully_synced(completion, connection):
	"""Belt-and-suspenders check that a single remote device has fully received
	the folder's current global state. THIS IS DELIBERATELY CONSERVATIVE.

	Background -- why these specific signals:

	* Syncthing exposes NO folder-level content hash / Merkle root over REST,
	  so we cannot directly diff "what the remote holds" against local content.
	  The need* counters below are the next best thing and are NOT second-hand:
	  needBytes/needItems/needDeletes for a (folder, device) pair are computed
	  by the local node by diffing its current global index against the index
	  the remote has *announced*. The remote announces files as it commits
	  them, carrying the version vectors that are tied to the block (SHA-256)
	  hashes. So need*==0 means the remote announced it holds every file in the
	  current global index at the exact content version we know about -- the
	  same version-vector comparison Syncthing's own sync engine uses.

	* The caller guarantees the just-scanned local changes are already in the
	  global index BEFORE this is first consulted (it waits for the scan to
	  actually finish via the StateChanged/LocalIndexUpdated events). That closes
	  the "need*==0 because the remote hasn't heard about the change yet" race: a
	  remote's need* reads > 0 until it actually pulls those changes. We intentionally
	  do NOT compare raw sequence numbers -- db/status.sequence (local) and
	  db/completion.sequence (the remote's own counter) are independent per-device
	  clocks and are not soundly comparable.

	* connected + remoteState=="valid" guards against trusting stale, last-known
	  completion for a device that is offline right now: a node that went offline
	  before the changes were made obviously does not have them, and
	  remoteState=="unknown" specifically means "not connected".
	"""
	if not connection.get("connected"):
		return False
	if completion.get("remoteState") != "valid":
		return False
	return (
		completion.get("needBytes", 1) == 0
		and completion.get("needItems", 1) == 0
		and completion.get("needDeletes", 1) == 0
	)


def print_changeset(client, folder_id, filenames):
	"""Show what the rescan detected as changed on disk.
	Returns {filename: size} so the live upload stream can show percentages."""
	if not filenames:
		print("Rescan detected no changed files (folder already matches the index).")
		return {}
	print(f"Rescan detected {len(filenames)} changed item{'s' if len(filenames) != 1 else ''}:")
	sizes = {}
	for name in sorted(filenames):
		try:
			info = client.get("/rest/db/file", folder=folder_id, file=name) or {}
			g = info.get("global") or {}
		except Exception:
			g = {}
		size = g.get("size", 0)
		sizes[name] = size
		if g.get("deleted"):
			print(f"  - {name} (deleted)")
		else:
			print(f"  + {name} ({_humanize_bytes(size)})")
	return sizes


def wait_for_remotes(client, folder_id, clauses, remote_devices, baseline_event_id):
	"""Drive the wait until every AND-clause holds. Returns an exit code.

	clauses: list of (raw_expr, ast_node). remote_devices: {device_id: name}.
	baseline_event_id: last /rest/events id captured BEFORE the scan was posted.
	"""
	# Banner -- state exactly what we are waiting for (folder-level, by design).
	print('Conditions (all must hold):')
	for raw, node in clauses:
		desc = node.describe()
		if desc.startswith("(") and desc.endswith(")"):
			desc = desc[1:-1]
		print(f"- {desc}")

	last_event_id = baseline_event_id
	scan_confirmed = False
	changeset = set()
	changeset_printed = False
	file_sizes = {}
	downloads = {}			# device_id -> {filename: bytes_downloaded}

	announced_full = set()		# devices we've already reported as fully received
	last_completion = {}		# device_id -> last printed completion %
	next_progress = 0.0
	next_no_remotes_warn = 0.0
	start = time.monotonic()

	try:
		while True:
			now = time.monotonic()

			# --- drain new events (non-blocking) -----------------------------
			# The events query param timeout=0 returns immediately with whatever
			# is queued, so the loop cadence stays at POLL_INTERVAL rather than
			# blocking on a long-poll.
			events = client.get("/rest/events", since=last_event_id, timeout=0, http_timeout=10) or []
			for ev in events:
				last_event_id = ev["id"]
				data = ev.get("data") or {}
				if data.get("folder") != folder_id:
					continue
				etype = ev.get("type")
				if etype == "StateChanged" and data.get("from") == "scanning":
					scan_confirmed = True
				elif etype == "LocalIndexUpdated":
					scan_confirmed = True
					changeset.update(data.get("filenames") or [])
				elif etype == "RemoteDownloadProgress":
					downloads[data.get("device")] = data.get("state") or {}

			# Print the changeset once the scan is confirmed complete.
			if scan_confirmed and not changeset_printed:
				file_sizes = print_changeset(client, folder_id, changeset)
				changeset_printed = True

			# --- poll completion for every remote device ---------------------
			connections = (client.get("/rest/system/connections") or {}).get("connections", {})
			world = {}
			any_online = False
			for device_id, name in remote_devices.items():
				conn = connections.get(device_id, {})
				if conn.get("connected"):
					any_online = True
				comp = client.get("/rest/db/completion", folder=folder_id, device=device_id) or {}
				received = is_remote_fully_synced(comp, conn)
				world[device_id] = received
				if received and device_id not in announced_full:
					announced_full.add(device_id)
					print(f'{name}: fully received')
				elif not received:
					announced_full.discard(device_id)
				last_completion[device_id] = comp.get("completion", 0.0)

			# --- success? only trust the world once the scan is confirmed ----
			if scan_confirmed and all(node.evaluate(world) for _, node in clauses):
				print(f"All conditions met in {now - start:.1f}s.")
				return 0

			# --- no online remotes: remind periodically ----------------------
			if not any_online and now >= next_no_remotes_warn:
				print("No online remote devices are sharing this folder; waiting for one to come online…")
				next_no_remotes_warn = now + NO_REMOTES_WARN_INTERVAL

			# --- throttled progress ------------------------------------------
			if now >= next_progress:
				for device_id, name in remote_devices.items():
					if device_id in announced_full:
						continue
					pct = last_completion.get(device_id, 0.0)
					active = downloads.get(device_id) or {}
					if active:
						# Show the file the node is currently pulling.
						fname, got = max(active.items(), key=lambda kv: kv[1])
						total = file_sizes.get(fname)
						frac = f" {_humanize_bytes(got)}/{_humanize_bytes(total)}" if total else f" {_humanize_bytes(got)}"
						print(f"{name}: {pct:.0f}% ← {fname}{frac}")
					elif any_online:
						print(f"{name}: {pct:.0f}%")
				next_progress = now + PROGRESS_THROTTLE

			# --- maintain cadence --------------------------------------------
			elapsed = time.monotonic() - now
			if elapsed < POLL_INTERVAL:
				time.sleep(POLL_INTERVAL - elapsed)
	except KeyboardInterrupt:
		print()
		print("Interrupted. Unmet conditions:")
		for raw, node in clauses:
			if not node.evaluate(world):
				desc = node.describe()
				if desc.startswith("(") and desc.endswith(")"):
					desc = desc[1:-1]
				print(f"- {desc}")
		return 130


# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------

def main() -> int:
	parser = argparse.ArgumentParser(
		description="Trigger an instant Syncthing rescan for a folder or subfolder.",
	)
	parser.add_argument("path", type=Path, nargs="?", default=Path.cwd(), help="Path to the synced folder or a subfolder within it (default: cwd).")
	parser.add_argument(
		"--wait-remote",
		dest="wait_remote",
		action="append",
		metavar="EXPR",
		help=(
			"After triggering the rescan, wait until remote devices have fully "
			"received the WHOLE folder. EXPR is a boolean expression over atoms "
			"count:N, name:VALUE, id:VALUE joined with AND/OR and grouped with "
			"parentheses, e.g. 'name:macbook AND (id:P56IOI7 OR name:nas)'. "
			"VALUE is a bareword or a JSON string (name:\"My laptop\"). Repeat "
			"the flag to add more clauses; all clauses must hold (AND)."
		),
	)
	args = parser.parse_args()

	what_to_sync_path = args.path.resolve()

	if not SYNCTHING_APP_CONFIG_PATH.is_file():
		print(f"Error: Syncthing config not found at {SYNCTHING_APP_CONFIG_PATH}", file=sys.stderr)
		return 1

	root = ET.parse(SYNCTHING_APP_CONFIG_PATH).getroot()

	api_key = root.findtext("gui/apikey", "")
	if not api_key:
		print(f"Error: Could not read Syncthing API key from {SYNCTHING_APP_CONFIG_PATH}", file=sys.stderr)
		return 2

	gui_address = root.findtext("gui/address", "127.0.0.1:8384")
	gui_tls = root.find("gui").get("tls", "false") == "true"

	# Build a map of normalized folder paths to their config elements.
	folders_by_path = {}
	for folder in root.iter("folder"):
		fpath = folder.get("path")
		if fpath and folder.get("id"):
			folders_by_path[Path(fpath).resolve()] = folder

	# Walk from what_to_sync_path upward to find the enclosing sync folder.
	folder_el = None
	sync_folder_path = None
	sub_path = None
	for candidate in [what_to_sync_path, *what_to_sync_path.parents]:
		if candidate in folders_by_path:
			folder_el = folders_by_path[candidate]
			sync_folder_path = candidate
			if candidate != what_to_sync_path:
				sub_path = what_to_sync_path.relative_to(candidate)
			break

	if folder_el is None:
		print(f"No Syncthing folder found matching {args.path!r} or any of its parent directories.", file=sys.stderr)
		print("Make sure the path is inside a folder managed by Syncthing.", file=sys.stderr)
		return 3

	folder_id = folder_el.get("id")

	ssl_ctx = None
	if gui_tls:
		ssl_ctx = ssl.create_default_context(cafile=SYNCTHING_APP_CONFIG_DIR / "https-cert.pem")
	base_url = urlunparse(("https" if gui_tls else "http", gui_address, "", "", "", ""))
	client = SyncthingClient(base_url, api_key, ssl_ctx)

	# If we will wait, resolve the expression and capture an event baseline
	# BEFORE triggering the scan -- both so we fail fast on a bad expression and
	# so we don't miss the scan's StateChanged/LocalIndexUpdated events.
	clauses = None
	baseline_event_id = 0
	if args.wait_remote:
		device_names = {d.get("id"): (d.get("name") or d.get("id")) for d in root.findall("device")}
		my_id = (client.get("/rest/system/status") or {}).get("myID")
		shared_ids = [d.get("id") for d in folder_el.findall("device")]
		remote_devices = {did: device_names.get(did, did) for did in shared_ids if did and did != my_id}
		if not remote_devices:
			print("This folder is not shared with any remote device; nothing to wait for.", file=sys.stderr)
			return 4

		resolver = make_device_resolver(remote_devices)
		clauses = []
		try:
			for raw in args.wait_remote:
				node = Parser(tokenize(raw), resolver).parse()
				clauses.append((raw, node))
		except ValueError as e:
			print(f"Error in --wait-remote {raw!r}: {e}", file=sys.stderr)
			return 5

		recent = client.get("/rest/events", limit=1) or []
		baseline_event_id = recent[-1]["id"] if recent else 0

	# Trigger the instant rescan.
	scan_query = {"folder": folder_id}
	if sub_path is not None:
		scan_query["sub"] = str(sub_path)
	client.post("/rest/db/scan", **scan_query)

	at_sub = f" at {sub_path}" if sub_path else ""
	print(f"Rescan triggered for {folder_id} ({sync_folder_path}){at_sub}.")

	if clauses:
		print(f'Waiting for the full folder "{folder_id}" to be received: {sync_folder_path}')
		return wait_for_remotes(client, folder_id, clauses, remote_devices, baseline_event_id)

	return 0


if __name__ == "__main__":
	sys.exit(main())
