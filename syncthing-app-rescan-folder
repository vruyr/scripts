# Wait loop
# --------------------------------------------------------------------------

def _humanize_bytes(n):
	step = 1024.0
	for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
		if abs(n) < step or unit == "TiB":
			return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
		n /= step


def is_remote_fully_synced(completion, connection):
	"""Belt-and-suspenders check that a single remote device has fully received
	the folder's current global state. THIS IS DELIBERATELY CONSERVATIVE.

	Background -- why these specific signals:

	* Syncthing exposes NO folder-level content hash / Merkle root over REST,
	  so we cannot directly diff "what the remote holds" against local content.
	  The need* counters below are the next best thing and are NOT second-hand:
	  needBytes/needItems/needDeletes for a (folder, device) pair are computed
	  by the local node by diffing its current global index against the index
	  the remote has *announced*. The remote announces files as it commits
	  them, carrying the version vectors that are tied to the block (SHA-256)
	  hashes. So need*==0 means the remote announced it holds every file in the
	  current global index at the exact content version we know about -- the
	  same version-vector comparison Syncthing's own sync engine uses.

	* The caller guarantees the just-scanned local changes are already in the
	  global index BEFORE this is first consulted (it waits for the scan to
	  actually finish via the StateChanged/LocalIndexUpdated events). That closes
	  the "need*==0 because the remote hasn't heard about the change yet" race: a
	  remote's need* reads > 0 until it actually pulls those changes. We intentionally
	  do NOT compare raw sequence numbers -- db/status.sequence (local) and
	  db/completion.sequence (the remote's own counter) are independent per-device
	  clocks and are not soundly comparable.

	* connected + remoteState=="valid" guards against trusting stale, last-known
	  completion for a device that is offline right now: a node that went offline
	  before the changes were made obviously does not have them, and
	  remoteState=="unknown" specifically means "not connected".
	"""
	if not connection.get("connected"):
		return False
	if completion.get("remoteState") != "valid":
		return False
	return (
		completion.get("needBytes", 1) == 0
		and completion.get("needItems", 1) == 0
		and completion.get("needDeletes", 1) == 0
	)


def print_changeset(client, folder_id, filenames, prefix=""):
	"""Show what the rescan detected as changed on disk.
	Returns {filename: size} so the live upload stream can show percentages."""
	if not filenames:
		print(f"{prefix}Rescan detected no changed files (folder already matches the index).")
		return {}
	print(f"{prefix}Rescan detected {len(filenames)} changed item{'s' if len(filenames) != 1 else ''}:")
	sizes = {}
	for name in sorted(filenames):
		try:
			info = client.get("/rest/db/file", folder=folder_id, file=name) or {}
			g = info.get("global") or {}
		except Exception:
			g = {}
		size = g.get("size", 0)
		sizes[name] = size
		if g.get("deleted"):
			print(f"{prefix}  - {name} (deleted)")
		else:
			print(f"{prefix}  + {name} ({_humanize_bytes(size)})")
	return sizes


def _strip_outer_parens(desc):
	return desc[1:-1] if desc.startswith("(") and desc.endswith(")") else desc


class FolderWait:
	"""Per-folder state tracked across the wait loop.

	remote_devices: {device_id: name} sharing this folder (excluding self).
	clauses: [(raw_expr, ast_node)] resolved against THIS folder's devices.
	"""

	def __init__(self, folder_id, folder_path, remote_devices, clauses):
		self.folder_id = folder_id
		self.folder_path = folder_path
		self.remote_devices = remote_devices
		self.clauses = clauses
		self.scan_confirmed = False
		self.changeset = set()
		self.changeset_printed = False
		self.file_sizes = {}
		self.downloads = {}			# device_id -> {filename: bytes_downloaded}
		self.announced_full = set()		# devices already reported fully received
		self.last_completion = {}		# device_id -> last completion %
		self.last_world = {}			# device_id -> fully-received bool (for unmet report)
		self.online = False
		self.done = False
		self.next_no_remotes_warn = 0.0


def wait_for_remotes(client, folders, baseline_event_id):
	"""Drive the wait until every clause holds for every folder. Returns an exit code.

	folders: list of FolderWait. baseline_event_id: last /rest/events id captured
	BEFORE any scan was posted, so we don't miss the scans' events.
	"""
	folders_by_id = {fw.folder_id: fw for fw in folders}
	multi = len(folders) > 1

	def tag(fw):
		# Label lines with the folder id only when more than one folder is in play,
		# so the common single-folder output stays uncluttered.
		return f"{fw.folder_id}: " if multi else ""

	# Banner -- one block per folder, stating exactly what we wait for (folder-level).
	for fw in folders:
		print(f'Waiting for the full folder "{fw.folder_id}" to be received: {fw.folder_path}')
		print("Conditions (all must hold):")
		for raw, node in fw.clauses:
			print(f"- {_strip_outer_parens(node.describe())}")

	last_event_id = baseline_event_id
	next_progress = 0.0
	start = time.monotonic()

	try:
		while True:
			now = time.monotonic()

			# --- drain new events (non-blocking), dispatch by folder ---------
			# The events query param timeout=0 returns immediately with whatever
			# is queued, so the loop cadence stays at POLL_INTERVAL rather than
			# blocking on a long-poll.
			events = client.get("/rest/events", since=last_event_id, timeout=0, http_timeout=10) or []
			for ev in events:
				last_event_id = ev["id"]
				data = ev.get("data") or {}
				fw = folders_by_id.get(data.get("folder"))
				if fw is None:
					continue
				etype = ev.get("type")
				if etype == "StateChanged" and data.get("from") == "scanning":
					fw.scan_confirmed = True
				elif etype == "LocalIndexUpdated":
					fw.scan_confirmed = True
					fw.changeset.update(data.get("filenames") or [])
				elif etype == "RemoteDownloadProgress":
					fw.downloads[data.get("device")] = data.get("state") or {}

			# Print each folder's changeset once its scan is confirmed complete.
			for fw in folders:
				if fw.scan_confirmed and not fw.changeset_printed:
					fw.file_sizes = print_changeset(client, fw.folder_id, fw.changeset, prefix=tag(fw))
					fw.changeset_printed = True

			# --- poll completion for every remote device of every folder -----
			connections = (client.get("/rest/system/connections") or {}).get("connections", {})
			all_done = True
			for fw in folders:
				world = {}
				fw.online = False
				for device_id, name in fw.remote_devices.items():
					conn = connections.get(device_id, {})
					if conn.get("connected"):
						fw.online = True
					comp = client.get("/rest/db/completion", folder=fw.folder_id, device=device_id) or {}
					received = is_remote_fully_synced(comp, conn)
					world[device_id] = received
					if received and device_id not in fw.announced_full:
						fw.announced_full.add(device_id)
						print(f'{tag(fw)}{name}: fully received')
					elif not received:
						fw.announced_full.discard(device_id)
					fw.last_completion[device_id] = comp.get("completion", 0.0)
				fw.last_world = world

				# Only trust this folder's world once its scan is confirmed.
				satisfied = fw.scan_confirmed and all(node.evaluate(world) for _, node in fw.clauses)
				if satisfied and not fw.done:
					fw.done = True
					if multi:
						print(f"{tag(fw)}all conditions met.")
				if not fw.done:
					all_done = False

			if all_done:
				if multi:
					print(f"All conditions met for {len(folders)} folders in {now - start:.1f}s.")
				else:
					print(f"All conditions met in {now - start:.1f}s.")
				return 0

			# --- per-folder: no online remotes, remind periodically ----------
			for fw in folders:
				if fw.done or fw.online or now < fw.next_no_remotes_warn:
					continue
				print(f"{tag(fw)}No online remote devices are sharing this folder; waiting for one to come online…")
				fw.next_no_remotes_warn = now + NO_REMOTES_WARN_INTERVAL

			# --- throttled progress ------------------------------------------
			if now >= next_progress:
				for fw in folders:
					if fw.done:
						continue
					for device_id, name in fw.remote_devices.items():
						if device_id in fw.announced_full:
							continue
						pct = fw.last_completion.get(device_id, 0.0)
						active = fw.downloads.get(device_id) or {}
						if active:
							# Show the file the node is currently pulling.
							fname, got = max(active.items(), key=lambda kv: kv[1])
							total = fw.file_sizes.get(fname)
							frac = f" {_humanize_bytes(got)}/{_humanize_bytes(total)}" if total else f" {_humanize_bytes(got)}"
							print(f"{tag(fw)}{name}: {pct:.0f}% ← {fname}{frac}")
						elif fw.online:
							print(f"{tag(fw)}{name}: {pct:.0f}%")
				next_progress = now + PROGRESS_THROTTLE

			# --- maintain cadence --------------------------------------------
			elapsed = time.monotonic() - now
			if elapsed < POLL_INTERVAL:
				time.sleep(POLL_INTERVAL - elapsed)
	except KeyboardInterrupt:
		print()
		print("Interrupted. Unmet conditions:")
		for fw in folders:
			if fw.done:
				continue
			for raw, node in fw.clauses:
				if not node.evaluate(fw.last_world):
					print(f"{tag(fw)}{_strip_outer_parens(node.describe())}")
		return 130


# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------

def main() -> int:
	parser = argparse.ArgumentParser(
		description="Trigger an instant Syncthing rescan for a folder or subfolder.",
	)
	parser.add_argument("path", type=Path, nargs="*", help="One or more paths, each a synced folder or a subfolder within one (default: cwd). Paths in the same Syncthing folder are coalesced.")
	parser.add_argument(
		"--wait-remote",
		dest="wait_remote",
		action="append",
		metavar="EXPR",
		help=(
			"After triggering the rescan(s), wait until remote devices have fully "
			"received the WHOLE of every involved folder. EXPR is a boolean "
			"expression over atoms count:N, name:VALUE, id:VALUE joined with AND/OR "
			"and grouped with parentheses, e.g. 'name:macbook AND (id:P56IOI7 OR "
			"name:nas)'. VALUE is a bareword or a JSON string (name:\"My laptop\"). "
			"Repeat the flag to add more clauses; all clauses must hold (AND), and "
			"every folder must satisfy them."
		),
	)
	args = parser.parse_args()

	paths = args.path or [Path.cwd()]

	if not SYNCTHING_APP_CONFIG_PATH.is_file():
		print(f"Error: Syncthing config not found at {SYNCTHING_APP_CONFIG_PATH}", file=sys.stderr)
		return 1

	root = ET.parse(SYNCTHING_APP_CONFIG_PATH).getroot()

	api_key = root.findtext("gui/apikey", "")
	if not api_key:
		print(f"Error: Could not read Syncthing API key from {SYNCTHING_APP_CONFIG_PATH}", file=sys.stderr)
		return 2

	gui_address = root.findtext("gui/address", "127.0.0.1:8384")
	gui_tls = root.find("gui").get("tls", "false") == "true"

	# Build a map of normalized folder paths to their config elements.
	folders_by_path = {}
	for folder in root.iter("folder"):
		fpath = folder.get("path")
		if fpath and folder.get("id"):
			folders_by_path[Path(fpath).resolve()] = folder

	# Resolve every input path to its enclosing Syncthing folder, coalescing
	# paths that fall in the same folder. Each target gathers the sub-paths to
	# rescan; a sub of None means "the whole folder" (a path at the folder root).
	# targets: {folder_id: {"el": <element>, "path": <root Path>, "subs": set}}
	targets = {}
	for given in paths:
		resolved = given.resolve()
		match = None
		for candidate in [resolved, *resolved.parents]:
			if candidate in folders_by_path:
				match = candidate
				break
		if match is None:
			print(f"No Syncthing folder found matching {str(given)!r} or any of its parent directories.", file=sys.stderr)
			print("Make sure the path is inside a folder managed by Syncthing.", file=sys.stderr)
			return 3
		el = folders_by_path[match]
		sub = None if match == resolved else resolved.relative_to(match)
		target = targets.setdefault(el.get("id"), {"el": el, "path": match, "subs": set()})
		target["subs"].add(sub)

	ssl_ctx = None
	if gui_tls:
		ssl_ctx = ssl.create_default_context(cafile=SYNCTHING_APP_CONFIG_DIR / "https-cert.pem")
	base_url = urlunparse(("https" if gui_tls else "http", gui_address, "", "", "", ""))
	client = SyncthingClient(base_url, api_key, ssl_ctx)

	# If we will wait, resolve the expression against each folder's own device
	# set and capture an event baseline BEFORE triggering any scan -- both to
	# fail fast on a bad expression and to not miss the scans' events.
	folder_waits = []
	baseline_event_id = 0
	if args.wait_remote:
		device_names = {d.get("id"): (d.get("name") or d.get("id")) for d in root.findall("device")}
		my_id = (client.get("/rest/system/status") or {}).get("myID")
		for folder_id, target in targets.items():
			shared_ids = [d.get("id") for d in target["el"].findall("device")]
			remote_devices = {did: device_names.get(did, did) for did in shared_ids if did and did != my_id}
			if not remote_devices:
				print(f'Folder "{folder_id}" ({target["path"]}) is not shared with any remote device; nothing to wait for.', file=sys.stderr)
				return 4

			resolver = make_device_resolver(remote_devices)
			clauses = []
			try:
				for raw in args.wait_remote:
					clauses.append((raw, Parser(tokenize(raw), resolver).parse()))
			except ValueError as e:
				print(f'Error in --wait-remote {raw!r} for folder "{folder_id}": {e}', file=sys.stderr)
				return 5
			folder_waits.append(FolderWait(folder_id, target["path"], remote_devices, clauses))

		recent = client.get("/rest/events", limit=1) or []
		baseline_event_id = recent[-1]["id"] if recent else 0

	# Trigger the instant rescan(s). One scan per sub-path; a whole-folder scan
	# (sub None) subsumes any sub-paths in the same folder.
	for folder_id, target in targets.items():
		subs = target["subs"]
		if None in subs:
			subs = [None]
		else:
			subs = sorted(subs, key=str)
		for sub in subs:
			scan_query = {"folder": folder_id}
			if sub is not None:
				scan_query["sub"] = str(sub)
			client.post("/rest/db/scan", **scan_query)
			at_sub = f" at {sub}" if sub is not None else ""
			print(f"Rescan triggered for {folder_id} ({target['path']}){at_sub}.")

	if folder_waits:
		return wait_for_remotes(client, folder_waits, baseline_event_id)

	return 0


if __name__ == "__main__":
	sys.exit(main())
