SYNCTHING_APP_CONFIG_DIR = Path.home() / "Library/Application Support/Syncthing"
SYNCTHING_APP_CONFIG_PATH = SYNCTHING_APP_CONFIG_DIR / "config.xml"

# How often we re-poll device completion while waiting.
POLL_INTERVAL = 0.25
# Per-device progress lines are emitted at most this often (the final
# "fully received" transition is always printed immediately, regardless).
PROGRESS_THROTTLE = 2.0
# When no remote device sharing the folder is online, we remind the user
# this often (polling itself stays at POLL_INTERVAL).
NO_REMOTES_WARN_INTERVAL = 5.0


# --------------------------------------------------------------------------
# Syncthing REST client
# --------------------------------------------------------------------------

class SyncthingClient:
	def __init__(self, base_url, api_key, ssl_ctx):
		self._base_url = base_url
		self._api_key = api_key
		self._ssl_ctx = ssl_ctx

	def _request(self, method, path, query=None, http_timeout=30):
		url = self._base_url + path
		if query:
			url += "?" + urlencode(query)
		req = Request(url, method=method, headers={"X-API-Key": self._api_key})
		with urlopen(req, context=self._ssl_ctx, timeout=http_timeout) as resp:
			body = resp.read()
		return json.loads(body) if body else None

	# http_timeout is the socket timeout; any other kwargs become query params
	# (note: the /rest/events endpoint has its own query param named 'timeout').
	def get(self, path, http_timeout=30, **query):
		return self._request("GET", path, query, http_timeout=http_timeout)

	def post(self, path, **query):
		return self._request("POST", path, query)


# --------------------------------------------------------------------------
# --wait-remote expression DSL
#
# Grammar (operators are keywords, case-insensitive; no implicit operators):
#
#     expr     := or_expr
#     or_expr  := and_expr (OR  and_expr)*
#     and_expr := unary    (AND unary)*
#     unary    := atom | '(' expr ')'
#     atom     := 'count:' INT | 'name:' VALUE | 'id:' VALUE
#     VALUE    := bareword (no spaces/parens/quotes) | JSON string
#
# AND binds tighter than OR; parentheses override. A VALUE may be a bareword
# or a JSON string literal (so names with spaces/quotes work):
#     name:"My \"main\" laptop"
#
# NOT is intentionally NOT implemented: "device is NOT synced" is not a
# meaningful wait condition (there is no use case for blocking until a node
# falls out of sync). The parser reserves the keyword so a future
# implementation has an obvious home; see parse_unary().
# --------------------------------------------------------------------------

_ATOM_PREFIXES = ("count:", "name:", "id:")
_KEYWORDS = {"AND", "OR", "NOT"}


class Token:
	__slots__ = ("kind", "value")

	def __init__(self, kind, value):
		self.kind = kind		# "PAREN" | "OP" | "ATOM"
		self.value = value


def _scan_json_string(s, i):
	"""Parse a JSON string literal starting at s[i] == '"'. Returns (text, next_i)."""
	j = i + 1
	while j < len(s):
		if s[j] == "\\":
			j += 2
			continue
		if s[j] == '"':
			j += 1
			break
		j += 1
	else:
		raise ValueError(f"unterminated quoted string in expression: {s[i:]!r}")
	return json.loads(s[i:j]), j


def _scan_bareword(s, i):
	"""Read until whitespace, paren, or quote. Returns (text, next_i)."""
	start = i
	while i < len(s) and not s[i].isspace() and s[i] not in "()\"":
		i += 1
	return s[start:i], i


def tokenize(expr):
	tokens = []
	i, n = 0, len(expr)
	while i < n:
		c = expr[i]
		if c.isspace():
			i += 1
			continue
		if c in "()":
			tokens.append(Token("PAREN", c))
			i += 1
			continue
		word, i = _scan_bareword(expr, i)
		matched_prefix = next((p for p in _ATOM_PREFIXES if word.lower().startswith(p)), None)
		if matched_prefix:
			prefix = matched_prefix
			value = word[len(prefix):]
			# A quoted value may follow the prefix directly (the bareword scan
			# stopped at the opening quote), e.g. name:"a b".
			if value == "" and i < n and expr[i] == '"':
				value, i = _scan_json_string(expr, i)
			tokens.append(Token("ATOM", (prefix, value)))
			continue
		if word.upper() in _KEYWORDS:
			tokens.append(Token("OP", word.upper()))
			continue
		raise ValueError(
			f"unexpected token {word!r}; expected an operator (AND/OR) or a "
			f"prefixed atom (count:/name:/id:)"
		)
	return tokens


# AST nodes. Each evaluates against `world`, a dict {device_id: is_fully_received}
# over all remote devices sharing the folder.

class And:
	def __init__(self, left, right):
		self.left, self.right = left, right

	def evaluate(self, world):
		return self.left.evaluate(world) and self.right.evaluate(world)

	def describe(self):
		return f"({self.left.describe()} AND {self.right.describe()})"


class Or:
	def __init__(self, left, right):
		self.left, self.right = left, right

	def evaluate(self, world):
		return self.left.evaluate(world) or self.right.evaluate(world)

	def describe(self):
		return f"({self.left.describe()} OR {self.right.describe()})"


class CountAtom:
	def __init__(self, n):
		self.n = n

	def evaluate(self, world):
		return sum(1 for received in world.values() if received) >= self.n

	def describe(self):
		return f"at least {self.n} device{'s' if self.n != 1 else ''} fully received"


class DeviceAtom:
	def __init__(self, device_id, name):
		self.device_id = device_id
		self.name = name

	def evaluate(self, world):
		return world.get(self.device_id, False)

	def describe(self):
		return f'device "{self.name}" ({self.device_id[:7]}…) fully received'


class Parser:
	"""Recursive-descent parser producing an AST.

	`resolve_device` maps a (prefix, value) name:/id: atom to a (device_id, name)
	pair, raising ValueError on unknown/ambiguous references.
	"""

	def __init__(self, tokens, resolve_device):
		self._tokens = tokens
		self._pos = 0
		self._resolve_device = resolve_device

	def _peek(self):
		return self._tokens[self._pos] if self._pos < len(self._tokens) else None

	def _advance(self):
		tok = self._tokens[self._pos]
		self._pos += 1
		return tok

	def parse(self):
		node = self.parse_or()
		if self._peek() is not None:
			raise ValueError("trailing tokens after a complete expression")
		return node

	def parse_or(self):
		node = self.parse_and()
		while (tok := self._peek()) and tok.kind == "OP" and tok.value == "OR":
			self._advance()
			node = Or(node, self.parse_and())
		return node

	def parse_and(self):
		node = self.parse_unary()
		while (tok := self._peek()) and tok.kind == "OP" and tok.value == "AND":
			self._advance()
			node = And(node, self.parse_unary())
		return node

	def parse_unary(self):
		tok = self._peek()
		if tok is None:
			raise ValueError("unexpected end of expression; expected an atom")
		if tok.kind == "OP" and tok.value == "NOT":
			# Reserved but unimplemented on purpose -- see the module comment.
			raise ValueError("NOT is not supported: waiting for a device to be "
				"un-synced is not a meaningful condition")
		if tok.kind == "PAREN" and tok.value == "(":
			self._advance()
			node = self.parse_or()
			close = self._peek()
			if not (close and close.kind == "PAREN" and close.value == ")"):
				raise ValueError("missing closing parenthesis")
			self._advance()
			return node
		if tok.kind == "ATOM":
			self._advance()
			return self._make_atom(tok.value)
		raise ValueError(f"expected an atom or '(', got {tok.value!r}")

	def _make_atom(self, atom):
		prefix, value = atom
		if prefix == "count:":
			try:
				n = int(value)
			except ValueError:
				raise ValueError(f"count: expects an integer, got {value!r}")
			if n < 1:
				raise ValueError(f"count: must be >= 1, got {n}")
			return CountAtom(n)
		device_id, name = self._resolve_device(prefix, value)
		return DeviceAtom(device_id, name)


def make_device_resolver(remote_devices):
	"""remote_devices: dict {device_id: name}. Matching is case-insensitive;
	id: accepts a unique prefix. Raises ValueError on unknown/ambiguous refs."""

	def resolve(prefix, value):
		needle = value.casefold()
		if prefix == "name:":
			matches = [(did, nm) for did, nm in remote_devices.items() if nm.casefold() == needle]
			what = f'name "{value}"'
		else:  # id:
			matches = [(did, nm) for did, nm in remote_devices.items() if did.casefold().startswith(needle)]
			what = f'id "{value}"'
		if not matches:
			known = ", ".join(f'"{nm}" ({did[:7]}…)' for did, nm in remote_devices.items()) or "(none)"
			raise ValueError(f"no remote device matches {what}; known devices: {known}")
		if len(matches) > 1:
			ambiguous = ", ".join(f'"{nm}" ({did[:7]}…)' for did, nm in matches)
			raise ValueError(f"{what} is ambiguous; matches: {ambiguous}")
		return matches[0]

	return resolve


